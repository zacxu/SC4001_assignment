{
  "schema_version": 1,
  "selection_seed": 42,
  "evaluation_seeds": [
    42,
    43,
    44,
    45,
    46
  ],
  "explanation_sampling_seed": 2026,
  "device": "cuda",
  "ray_max_concurrent_trials": 1,
  "ray_gpus_per_trial": 1,
  "data_loader_workers": 0,
  "deterministic_algorithms": true,
  "deterministic_warn_only": true,
  "cudnn_benchmark": false,
  "cublas_workspace_config": ":4096:8",
  "housing_project": "housing_baseline_data/hdb-price-prediction-assignment-main",
  "housing_csv": "housing_baseline_data/hdb-price-prediction-assignment-main/hdb_price_prediction.csv",
  "chest_xray_npz": "chestxray_binary_64.npz",
  "training": {
    "optimizer": "Adam",
    "max_epochs": 20,
    "patience": 4,
    "min_delta": 0.0001
  },
  "part_a": {
    "train_years": [
      2017,
      2018,
      2019,
      2020
    ],
    "validation_year": 2021,
    "test_year": 2022,
    "excluded_years": [
      2023
    ],
    "default_embedding_dimension": 8,
    "default_hidden_width": 64,
    "learning_rate": 0.01,
    "batch_size": 512,
    "selection_monitor": "validation_rmse_sgd",
    "a1_refit_monitor": "test_rmse_sgd",
    "a2_a3_refit_epoch_budget": "a1_final_best_checkpoint_epoch",
    "hidden_width_grid": [
      16,
      32,
      64,
      128,
      256
    ],
    "embedding_dimension_grid": [
      2,
      4,
      8,
      12,
      16
    ],
    "lambda_grid": [
      0,
      0.25,
      0.5,
      1,
      2
    ],
    "categorical_features": [
      "month",
      "town",
      "flat_model_type",
      "storey_range"
    ],
    "continuous_features": [
      "dist_to_nearest_stn",
      "dist_to_dhoby",
      "degree_centrality",
      "eigenvector_centrality",
      "remaining_lease_years",
      "floor_area_sqm"
    ]
  },
  "part_b": {
    "class_mapping_assumption": {
      "0": "healthy",
      "1": "pneumonia"
    },
    "output": "unrestricted_binary_logit",
    "loss": "BCEWithLogitsLoss",
    "probability_threshold": 0.5,
    "stopping_monitor": "validation_loss",
    "checkpoint_selection": "validation_error_then_loss_then_earlier_epoch",
    "learning_rate_grid": [
      1e-05,
      0.0001,
      0.001,
      0.01,
      0.1
    ],
    "b1_batch_size": 128,
    "batch_size_grid": [
      16,
      32,
      64,
      128,
      256
    ],
    "normalization": "training_pixel_mean_and_population_std_after_dividing_by_255"
  }
}
